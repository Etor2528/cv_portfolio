---

const { title, description, tech } = Astro.props;

---

<article class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
  <h3 class="text-xl font-bold text-white">{title}</h3>
  <p class="mt-3 text-slate-400">{description}</p>

  <div class="mt-4 flex flex-wrap gap-2">
    {tech.map((item) => (
      <span class="rounded-full bg-cyan-500/10 px-3 py-1 text-sm text-cyan-300">
        {item}
      </span>
    ))}
  </div>
</article>