---
const { role, company, period, bullets } = Astro.props;
---

<article class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
  <h3 class="text-xl font-bold text-white">{role}</h3>
  <p class="mt-1 text-sm text-cyan-400">{company} | {period}</p>

  <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-400">
    {bullets.map((bullet) => (
      <li>{bullet}</li>
    ))}
  </ul>
</article>