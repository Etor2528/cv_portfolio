---
interface Props {
  title: string;
  issuer: string;
  year: string;
  image: string;
  description: string;
  credential?: string;
  status: "Completed" | "In Progress" | "Planned";
}

const {
  title,
  issuer,
  year,
  image,
  description,
  credential,
  status,
} = Astro.props as Props;

const colors = {
  Completed: "bg-emerald-500/20 text-emerald-400",
  "In Progress": "bg-yellow-500/20 text-yellow-400",
  Planned: "bg-slate-700 text-slate-300",
};
---

<div
  class="group overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 transition hover:-translate-y-2 hover:border-cyan-500"
>
  <img
    src={image}
    alt={title}
    class="h-52 w-full object-cover"
  />

  <div class="p-6">

    <div class="mb-4 flex items-center justify-between">

      <span class={`rounded-full px-3 py-1 text-xs ${colors[status]}`}>
        {status}
      </span>

      <span class="text-sm text-slate-400">
        {year}
      </span>

    </div>

    <h3 class="text-xl font-bold text-white">
      {title}
    </h3>

    <p class="mt-1 text-cyan-400">
      {issuer}
    </p>

    <p class="mt-4 text-slate-400">
      {description}
    </p>

    {
      credential && (
        <a
          href={credential}
          target="_blank"
          class="mt-6 inline-block text-cyan-400 hover:text-cyan-300"
        >
          View Credential →
        </a>
      )
    }

  </div>
</div>